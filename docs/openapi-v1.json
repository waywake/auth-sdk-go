          },
          "503": {
            "description": "Dependency unavailable; access refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckResponse"
                }
              }
            }
          }
        },
        "description": "Bearer token and application egress IP allowlist required. No query parameters or arbitrary user/app selectors are accepted. All responses are no-store. JSON body limit 4096 bytes; unknown fields and trailing documents are rejected.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckInput"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "clientBasic": {
        "type": "http",
        "scheme": "basic",
        "description": "APP_ID:OPENAPI_SECRET (oas_...), never the legacy RPC secret"
      },
      "browserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "u",
        "description": "Existing Auth browser session, only at authorization endpoint"
      },
      "oauth": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "/openapi/v1/oauth/authorize",
            "tokenUrl": "/openapi/v1/oauth/token",
            "scopes": {
              "profile:read": "Minimal current user profile",
              "permissions:read": "Current application roles and permissions",
              "permissions:check": "Check a current application permission"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "request_id"
        ],
        "additionalProperties": false
      },
      "Token": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "pattern": "^oat_[A-Za-z0-9_-]{43}$"
          },
          "token_type": {
            "const": "Bearer"
          },
          "expires_in": {
            "const": 900
          },
          "scope": {
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "scope"
        ],
        "additionalProperties": false
      },
      "Profile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "avatar": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "name",
          "avatar"
        ],
        "additionalProperties": false
      },
      "Permissions": {
        "type": "object",
        "properties": {
          "app_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "user_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "app_id",
          "user_id",
          "roles",
          "permissions"
        ],
        "additionalProperties": false
      },
      "Check": {
        "type": "object",
        "properties": {
          "allowed": {
            "type": "boolean"
          }
        },
        "required": [
          "allowed"
        ],
        "additionalProperties": false
      },
      "CheckInput": {
        "type": "object",
        "properties": {
          "permission": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "permission"
        ],
        "additionalProperties": false
      },
      "ProfileResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Profile"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "data",
          "request_id"
        ],
        "additionalProperties": false
      },
      "PermissionsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Permissions"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "data",
          "request_id"
        ],
        "additionalProperties": false
      },
      "CheckResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Check"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "data",
          "request_id"
        ],
        "additionalProperties": false
      }
    }
  }
}
