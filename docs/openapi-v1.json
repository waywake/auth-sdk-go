{
  "openapi": "3.1.0",
  "info": {
    "title": "Auth Public OpenAPI",
    "version": "1.0.0",
    "description": "Confidential server-side applications only. HTTPS required. Application-level IP allowlist, explicit scopes, S256 PKCE and independent rotatable credentials. See openapi.md for proxy deployment and rollout requirements."
  },
  "servers": [
    {
      "url": "https://auth.example.com",
      "description": "Replace with the deployment HTTPS origin"
    }
  ],
  "paths": {
    "/openapi/v1/oauth/authorize": {
      "get": {
        "operationId": "authorize",
        "summary": "Browser login and authorization code with mandatory S256 PKCE",
        "security": [
          {
            "browserSession": []
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid parameters, scope or grant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid client or access token; WWW-Authenticate is included",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "HTTPS, application IP or scope policy refused access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Shared rate limit exceeded; retry after 60 seconds",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "const": 60
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable; access refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "302": {
            "description": "Redirect to registered URI with a 120-second single-use code and original state, or to Auth login when unauthenticated.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        },
        "description": "The app must already be enabled and configured. The browser is not subject to the application server IP allowlist. Invalid redirect URIs are never followed. All parameters are required, single-valued, and unknown parameters are rejected. Missing browser login redirects to Auth login.",
        "parameters": [
          {
            "name": "response_type",
            "in": "query",
            "required": true,
            "schema": {
              "const": "code"
            }
          },
          {
            "name": "client_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          {
            "name": "redirect_uri",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048
            }
          },
          {
            "name": "scope",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Space-separated nonempty subset of profile:read, permissions:read, permissions:check"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 32,
              "maxLength": 512
            }
          },
          {
            "name": "code_challenge",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          },
          {
            "name": "code_challenge_method",
            "in": "query",
            "required": true,
            "schema": {
              "const": "S256"
            }
          }
        ]
      }
    },
    "/openapi/v1/oauth/token": {
      "post": {
        "operationId": "exchangeAuthorizationCode",
        "summary": "Exchange one-time code using the independent OpenAPI secret",
        "security": [
          {
            "clientBasic": []
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid parameters, scope or grant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid client or access token; WWW-Authenticate is included",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "HTTPS, application IP or scope policy refused access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Shared rate limit exceeded; retry after 60 seconds",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "const": 60
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable; access refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "grant_type": {
                    "const": "authorization_code"
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^oac_[A-Za-z0-9_-]{43}$"
                  },
                  "redirect_uri": {
                    "type": "string",
                    "format": "uri",
                    "description": "Identical to the URI used at authorization"
                  },
                  "code_verifier": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._~-]{43,128}$"
                  }
                },
                "required": [
                  "grant_type",
                  "code",
                  "redirect_uri",
                  "code_verifier"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "description": "Application IP allowlist required. Body limit 8192 bytes. No refresh_token or client_credentials grant. Duplicate and unknown form fields are rejected. Authentication is HTTP Basic APP_ID:OPENAPI_SECRET; legacy apps.secret is not accepted."
      }
    },
    "/openapi/v1/oauth/revoke": {
      "post": {
        "operationId": "revokeToken",
        "summary": "Idempotently revoke a token belonging to this application",
        "security": [
          {
            "clientBasic": []
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid parameters, scope or grant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid client or access token; WWW-Authenticate is included",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "HTTPS, application IP or scope policy refused access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Shared rate limit exceeded; retry after 60 seconds",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "const": 60
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable; access refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Empty response, including unknown or other-application tokens."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "minLength": 1
                  },
                  "token_type_hint": {
                    "type": "string"
                  }
                },
                "required": [
                  "token"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/openapi/v1/me": {
      "get": {
        "operationId": "getCurrentUser",
        "summary": "Read minimal current user profile",
        "security": [
          {
            "oauth": [
              "profile:read"
            ]
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid parameters, scope or grant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid client or access token; WWW-Authenticate is included",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "HTTPS, application IP or scope policy refused access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Shared rate limit exceeded; retry after 60 seconds",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "const": 60
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable; access refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          }
        },
        "description": "Bearer token and application egress IP allowlist required. No query parameters or arbitrary user/app selectors are accepted. All responses are no-store."
      }
    },
    "/openapi/v1/me/permissions": {
      "get": {
        "operationId": "getCurrentPermissions",
        "summary": "Read current user roles and permissions in this application",
        "security": [
          {
            "oauth": [
              "permissions:read"
            ]
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid parameters, scope or grant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid client or access token; WWW-Authenticate is included",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "HTTPS, application IP or scope policy refused access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Shared rate limit exceeded; retry after 60 seconds",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "const": 60
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable; access refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PermissionsResponse"
                }
              }
            }
          }
        },
        "description": "Bearer token and application egress IP allowlist required. No query parameters or arbitrary user/app selectors are accepted. All responses are no-store."
      }
    },
    "/openapi/v1/me/permissions/check": {
      "post": {
        "operationId": "checkCurrentPermission",
        "summary": "Check a current user permission in this application",
        "security": [
          {
            "oauth": [
              "permissions:check"
            ]
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid parameters, scope or grant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid client or access token; WWW-Authenticate is included",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "HTTPS, application IP or scope policy refused access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Shared rate limit exceeded; retry after 60 seconds",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "const": 60
                }
              }
